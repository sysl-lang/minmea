// minmea for sysl: a small NMEA 0183 sentence parser for the GPS module on a UART, bound to the minmea
// C library (kosma/minmea), vendored unchanged.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       minmea { git = "github.com/sysl-lang/minmea", version = "<the first tag>" }
//     }
//
// The module is `sh.sysl.minmea`.

package {
  name    = "minmea"
  version = "0.0.1"
}

// **What minmea is compiled with is this package's decision, not a consumer's.** minmea reads two
// things from the build environment:
//
// - `MINMEA_MAX_SENTENCE_LENGTH = 83`. The library itself never uses it: it is the size upstream's
//   examples and tests give a line buffer, and the binding gives its own copy of a line the same
//   size. NMEA 0183 limits a sentence to 82 characters counting the leading `$` and the trailing
//   CR LF, and a buffer needs one more byte for the NUL C wants, so 83 holds every legal sentence;
//   upstream's default of 80 would refuse a legal 82-character GSV. A longer line is answered
//   `Error.TooLong` rather than truncated.
//
// - `MINMEA_INCLUDE_COMPAT` is NOT set. It exists for Windows and TI-RTOS, which lack `<time.h>`
//   pieces minmea uses; every target this package is for has them.
//
// - `timegm` is NOT redefined as `mktime`. `minmea_gettime` calls `timegm`, which Darwin and glibc
//   have and a newlib board does not; upstream's advice for such a system is `-Dtimegm=mktime`,
//   which is right only while the process runs in UTC and would make a host build's timestamps
//   depend on the machine's time zone. Only `unix_time` reaches it, so a board without `timegm`
//   links when that function is unused (`--gc-sections`) and a consumer that needs it supplies it.
defines {
  "sh/sysl/minmea/c/{minmea,shim}.c" {
    MINMEA_MAX_SENTENCE_LENGTH = 83
  }
}
