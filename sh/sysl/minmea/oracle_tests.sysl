module sh.sysl.minmea
@tests
@requires(heap, os)

import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.split

// The binding against minmea driven from C. A program written straight against `minmea.h`, compiled
// from the same vendored source with the same options, takes a corpus of lines as its arguments and
// prints, for each, whether it is a sentence, which kind, its checksum and every field of its parse,
// including the three float conversions and two rescales of every fixed-point value. The binding
// prints the same text from its own types, and the two outputs must be the same bytes. A field read
// from the wrong offset, a sign applied to the wrong coordinate, a scale lost, a sentence type
// mapped to its neighbour or an FAA letter mapped to the wrong variant all change the text.
//
// Lines longer than the binding's buffer are not in the corpus: C reads any length and the binding
// refuses past `MAX_LINE`, which the unit tests cover.

private val DRIVER: string = raw"""
    #include <stdio.h>
    #include <string.h>
    #include <stdint.h>
    #include "minmea.h"

    static unsigned bits(float f) { uint32_t u; memcpy(&u, &f, sizeof u); return u; }

    static void pf(struct minmea_float f) {
        printf("%d/%d/%u/%u/%d/%d", (int) f.value, (int) f.scale, bits(minmea_tofloat(&f)),
               bits(minmea_tocoord(&f)), (int) minmea_rescale(&f, 10), (int) minmea_rescale(&f, 1000));
    }
    static void pt(struct minmea_time t) { printf("%d:%d:%d.%d", t.hours, t.minutes, t.seconds, t.microseconds); }
    static void pd(struct minmea_date d) { printf("%d-%d-%d", d.day, d.month, d.year); }
    static void pk(const union minmea_type *k) { printf("%d,%d", k->talker_id[0], k->talker_id[1]); }
    static void sp(void) { printf(" "); }

    static void show(int i, const char *line) {
        int id = (int) minmea_sentence_id(line, false);
        int chk = minmea_check(line, false);
        printf("%d chk=%d strict=%d id=%d sum=%u ", i, chk, minmea_check(line, true), id, (unsigned) minmea_checksum(line));
        if (!chk || id == MINMEA_INVALID) { printf("invalid\n"); return; }
        switch (id) {
        case MINMEA_SENTENCE_RMC: {
            struct minmea_sentence_rmc f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_rmc(&f, line)) break;
            printf("RMC "); pk(&f.type); sp(); pt(f.time); printf(" valid=%d ", f.valid);
            pf(f.latitude); sp(); pf(f.longitude); sp(); pf(f.speed); sp(); pf(f.course); sp();
            pd(f.date); sp(); pf(f.variation); printf("\n");
            return;
        }
        case MINMEA_SENTENCE_GGA: {
            struct minmea_sentence_gga f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gga(&f, line)) break;
            printf("GGA "); pk(&f.type); sp(); pt(f.time); sp(); pf(f.latitude); sp(); pf(f.longitude);
            printf(" q=%d n=%d ", f.fix_quality, f.satellites_tracked); pf(f.hdop); sp(); pf(f.altitude);
            printf(" au=%d ", f.altitude_units); pf(f.height); printf(" hu=%d ", f.height_units);
            pf(f.dgps_age); printf("\n");
            return;
        }
        case MINMEA_SENTENCE_GLL: {
            struct minmea_sentence_gll f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gll(&f, line)) break;
            printf("GLL "); pk(&f.type); sp(); pf(f.latitude); sp(); pf(f.longitude); sp(); pt(f.time);
            printf(" valid=%d mode=%d\n", f.status == MINMEA_GLL_STATUS_DATA_VALID, f.mode);
            return;
        }
        case MINMEA_SENTENCE_GSA: {
            struct minmea_sentence_gsa f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gsa(&f, line)) break;
            printf("GSA "); pk(&f.type); printf(" mode=%d fix=%d sats=", f.mode, f.fix_type);
            for (int k = 0; k < 12; k++) printf("%d,", f.sats[k]);
            sp(); pf(f.pdop); sp(); pf(f.hdop); sp(); pf(f.vdop); printf("\n");
            return;
        }
        case MINMEA_SENTENCE_GST: {
            struct minmea_sentence_gst f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gst(&f, line)) break;
            printf("GST "); pk(&f.type); sp(); pt(f.time); sp(); pf(f.rms_deviation); sp();
            pf(f.semi_major_deviation); sp(); pf(f.semi_minor_deviation); sp(); pf(f.semi_major_orientation); sp();
            pf(f.latitude_error_deviation); sp(); pf(f.longitude_error_deviation); sp();
            pf(f.altitude_error_deviation); printf("\n");
            return;
        }
        case MINMEA_SENTENCE_GSV: {
            struct minmea_sentence_gsv f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gsv(&f, line)) break;
            printf("GSV "); pk(&f.type); printf(" %d %d %d", f.total_msgs, f.msg_nr, f.total_sats);
            for (int k = 0; k < 4; k++) {
                printf(" [%d,%d,%d,", f.sats[k].nr, f.sats[k].elevation, f.sats[k].azimuth);
                pf(f.sats[k].snr); printf("]");
            }
            printf("\n");
            return;
        }
        case MINMEA_SENTENCE_VTG: {
            struct minmea_sentence_vtg f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_vtg(&f, line)) break;
            printf("VTG "); pk(&f.type); sp(); pf(f.true_track_degrees); sp(); pf(f.magnetic_track_degrees); sp();
            pf(f.speed_knots); sp(); pf(f.speed_kph); printf(" mode=%d\n", (int) f.faa_mode);
            return;
        }
        case MINMEA_SENTENCE_ZDA: {
            struct minmea_sentence_zda f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_zda(&f, line)) break;
            printf("ZDA "); pk(&f.type); sp(); pt(f.time); sp(); pd(f.date);
            printf(" %d %d\n", f.hour_offset, f.minute_offset);
            return;
        }
        case MINMEA_SENTENCE_GBS: {
            struct minmea_sentence_gbs f;
            memset(&f, 0, sizeof f);
            if (!minmea_parse_gbs(&f, line)) break;
            printf("GBS "); pk(&f.type); sp(); pt(f.time); sp(); pf(f.err_latitude); sp(); pf(f.err_longitude); sp();
            pf(f.err_altitude); printf(" svid=%d ", f.svid); pf(f.prob); sp(); pf(f.bias); sp(); pf(f.stddev);
            printf("\n");
            return;
        }
        default:
            printf("unsupported\n");
            return;
        }
        printf("malformed\n");
    }

    int main(int argc, char **argv) {
        for (int i = 1; i < argc; i++) show(i - 1, argv[i]);
        return 0;
    }
    """

private val C_DIR: string = "sh/sysl/minmea/c"

// Real sentences, minmea's own vectors, malformed ones and one of each FAA mode and fix type.
