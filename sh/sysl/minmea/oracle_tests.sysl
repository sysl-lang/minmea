@test("the binding prints the same fields as minmea driven from C, for every sentence in the corpus")
same_text_as_c()
    val dir = make_temp_dir("minmea-oracle-").unwrap()
    val source = s"${dir}/driver.c"
    val program = s"${dir}/driver"
    write_text(source, DRIVER).unwrap()
    val built = capture("clang", ["-O1", "-I", C_DIR, "-DMINMEA_MAX_SENTENCE_LENGTH=83", "-o", program, source,
                                  s"${C_DIR}/minmea.c"], stderr = true).unwrap()
    assert(built.status.ok(), s"the C driver did not build: ${built.text}")
    val ran = capture(program, CORPUS[..], stderr = true).unwrap()
    assert(ran.status.ok(), "the C driver failed")
    val theirs = split(ran.text, "\n")
    assert_eq(theirs.len, CORPUS.len + 1)
    for i in 0..<CORPUS.len
        assert_eq(render(i, CORPUS[i]), theirs[i], s"line ${i}")
    remove_dir_all(dir).unwrap()

@test("the corpus holds every sentence type and the failures, so the comparison can disagree")
corpus_covers()
    assert(CORPUS.len >= 30)
    var seen: [11]int = [0; 11]
    var failures = 0
    for line in CORPUS
        val k = kind(line, false)
        seen[kind_number(k) + 1] += 1
        if !check(line, false) then failures += 1
    for i in 0..<seen.len
        assert(seen[i] > 0, s"no line of kind ${int(i) - 1}")
    assert(failures >= 8)

// The text of one line, in the shape the C driver prints.
private render(index: usize, line: string) -> string
    val chk = if check(line, false) then 1 else 0
    val strict = if check(line, true) then 1 else 0
    val sum = checksum(line).unwrap()
    val head = f"${index} chk=${chk} strict=${strict} id=${kind_number(kind(line, false))} sum=${sum}%u "
    head + match_text_of(parse(line))

private kind_number(k: Kind) -> int
    k match
        Kind.Invalid -> -1
        Kind.Unknown -> 0
        Kind.Gbs -> 1
        Kind.Gga -> 2
        Kind.Gll -> 3
        Kind.Gsa -> 4
        Kind.Gst -> 5
        Kind.Gsv -> 6
        Kind.Rmc -> 7
        Kind.Vtg -> 8
        Kind.Zda -> 9

private fixed_text(a: Fixed) -> string
    f"${a.value}/${a.scale}/${a.to_f32().bits()}%u/${a.to_coord().bits()}%u/${a.rescale(10)}/${a.rescale(1000)}"

private time_text(t: Time) -> string = s"${t.hours}:${t.minutes}:${t.seconds}.${t.microseconds}"

private date_text(d: Date) -> string = s"${d.day}-${d.month}-${d.year}"

private talker_text(t: Talker) -> string = s"${t[0]},${t[1]}"

private flag(b: bool) -> int = if b then 1 else 0

// The character each FAA mode stands for, 0 for none.
private faa_code(m: FaaMode) -> int
    m match
        FaaMode.Autonomous -> 65
        FaaMode.Differential -> 68
        FaaMode.Estimated -> 69
        FaaMode.Manual -> 77
        FaaMode.Simulated -> 83
        FaaMode.NotValid -> 78
        FaaMode.Precise -> 80
        FaaMode.Missing -> 0
        FaaMode.Other(code) -> int(code)

private gsa_mode_code(m: GsaMode) -> int
    m match
        GsaMode.Automatic -> 65
        GsaMode.Manual -> 77
        GsaMode.Missing -> 0
        GsaMode.Other(code) -> int(code)

private fix_code(t: FixType) -> int
    t match
        FixType.NoFix -> 1
        FixType.Fix2D -> 2
        FixType.Fix3D -> 3
        FixType.Missing -> 0
        FixType.Other(code) -> code

private position_text(p: Position) -> string = s"${fixed_text(p.latitude)} ${fixed_text(p.longitude)}"

private sentence_text(s: Sentence) -> string
    s match
        Sentence.Rmc(f) ->
            s"RMC ${talker_text(f.talker)} ${time_text(f.time)} valid=${flag(f.valid)} ${position_text(f.position)} ${fixed_text(f.speed)} ${fixed_text(f.course)} ${date_text(f.date)} ${fixed_text(f.variation)}"
        Sentence.Gga(f) ->
            s"GGA ${talker_text(f.talker)} ${time_text(f.time)} ${position_text(f.position)} q=${f.fix_quality} n=${f.satellites_tracked} ${fixed_text(f.hdop)} ${fixed_text(f.altitude)} au=${f.altitude_units} ${fixed_text(f.height)} hu=${f.height_units} ${fixed_text(f.dgps_age)}"
        Sentence.Gll(f) ->
            s"GLL ${talker_text(f.talker)} ${position_text(f.position)} ${time_text(f.time)} valid=${flag(f.valid)} mode=${faa_code(f.mode)}"
        Sentence.Gsa(f) ->
            s"GSA ${talker_text(f.talker)} mode=${gsa_mode_code(f.mode)} fix=${fix_code(f.fix_type)} sats=${sats_text(f.sats)} ${fixed_text(f.pdop)} ${fixed_text(f.hdop)} ${fixed_text(f.vdop)}"
        Sentence.Gst(f) ->
            s"GST ${talker_text(f.talker)} ${time_text(f.time)} ${fixed_text(f.rms_deviation)} ${fixed_text(f.semi_major_deviation)} ${fixed_text(f.semi_minor_deviation)} ${fixed_text(f.semi_major_orientation)} ${fixed_text(f.latitude_error_deviation)} ${fixed_text(f.longitude_error_deviation)} ${fixed_text(f.altitude_error_deviation)}"
        Sentence.Gsv(f) ->
            s"GSV ${talker_text(f.talker)} ${f.total_msgs} ${f.msg_nr} ${f.total_sats} ${satellite_text(f.sats[0])} ${satellite_text(f.sats[1])} ${satellite_text(f.sats[2])} ${satellite_text(f.sats[3])}"
        Sentence.Vtg(f) ->
            s"VTG ${talker_text(f.talker)} ${fixed_text(f.true_track_degrees)} ${fixed_text(f.magnetic_track_degrees)} ${fixed_text(f.speed_knots)} ${fixed_text(f.speed_kph)} mode=${faa_code(f.faa_mode)}"
        Sentence.Zda(f) ->
            s"ZDA ${talker_text(f.talker)} ${time_text(f.time)} ${date_text(f.date)} ${f.hour_offset} ${f.minute_offset}"
        Sentence.Gbs(f) ->
            s"GBS ${talker_text(f.talker)} ${time_text(f.time)} ${fixed_text(f.err_latitude)} ${fixed_text(f.err_longitude)} ${fixed_text(f.err_altitude)} svid=${f.svid} ${fixed_text(f.prob)} ${fixed_text(f.bias)} ${fixed_text(f.stddev)}"

private sats_text(sats: [12]int) -> string
    var out = ""
    for n in sats
        out += s"${n},"
    out

private satellite_text(x: Satellite) -> string = s"[${x.nr},${x.elevation},${x.azimuth},${fixed_text(x.snr)}]"

private match_text_of(result: Result[Sentence, Error]) -> string
    result match
        Ok(sentence) -> sentence_text(sentence)
        Err(Error.Unsupported) -> "unsupported"
        Err(Error.Malformed) -> "malformed"
        Err(_) -> "invalid"
